# Copy to .env and fill with real values before `docker compose up --env-file .env`

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME__

# API
AUTH_SECRET=__CHANGE_ME_64_HEX__
ADMIN_EMAIL=__CHANGE_ME__@example.com
ADMIN_PASSWORD=__CHANGE_ME_AT_LEAST_8__
AUTH_COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:8088
PORT=3000